module

public import PolyhexHull.Rooted
public import PolyhexHull.Symmetry

@[expose] public section

/-!
# Uniqueness of the extremal polyhex

**Theorem.** If the convex hull of a polyhex with `n` cells has the largest possible area
`⌈n² + 14n/3⌉ / 6`, then the polyhex is the image of the washtub `washtub n` under one of the
lattice symmetries generated by `ρ` and `σ`, followed by a translation.

The proof follows the informal argument of the note *Uniqueness of the extremal polyhex for the
maximal convex hull*:

1. `extremal_growth`: for every growth order, `W = 3s + m` and the direction counts are balanced.
2. `Growth.exists_wide`: the full edges form one class `d`, and the width for `form (d + 2)` is
   `s + m`.
3. Rotate by `ρ^j` so that this form becomes `form 2`, and take a growth order rooted at a cell
   where `form 2` is smallest. `Growth.rooted_path` and `Growth.rooted_pattern` show that the
   growth order is a walk `A^x d₁^(y-x) B^(s-y)` with `{A, B} = {d₂, d₃}`. Small cases are done by
   hand.
4. Balanced counts identify the three run lengths, and `tub_rev` handles the two orders of the
   short runs.
-/

namespace Polyhex

open MeasureTheory Finset
open scoped Fin.NatCast

/-- The run lengths `(x, y - x, s - y)` are those of a washtub with `s + 1` cells, in one of the
two orders of the outer runs. -/
def Trip (s x y : ℕ) : Prop :=
  y - x = (s + 2) / 3 ∧ ((x = (s + 1) / 3 ∧ s - y = s / 3) ∨ (x = s / 3 ∧ s - y = (s + 1) / 3))

lemma mm_of_balanced {a b c : ℕ} (h : Balanced a b c) : max a (max b c) = (a + b + c + 2) / 3 := by
  unfold Balanced at h; omega

namespace Growth

variable {S : Finset Cell} (g : Growth S)

lemma count_of_pattern {x y : ℕ} {b : Bool} (hxy : x ≤ y) (hy : y ≤ g.s)
    (hp : ∀ i ∈ Icc 1 g.s, g.e i = sw b (std x y i)) :
    g.count 0 = y - x ∧ g.count 1 = (if b then g.s - y else x) ∧
      g.count 2 = (if b then x else g.s - y) := by
  have hf : ∀ k, g.count k = #{i ∈ Icc 1 g.s | cls (sw b (std x y i)) = k} := fun k => by
    unfold count; congr 1; exact filter_congr fun i hi => by rw [hp i hi]
  have c0 : {i ∈ Icc 1 g.s | cls (sw b (std x y i)) = 0} = {i ∈ Icc 1 g.s | ¬ i ≤ x ∧ i ≤ y} :=
    filter_congr fun i _ => by rw [cls_sw_std]; cases b <;> split_ifs <;> simp_all
  have cA : {i ∈ Icc 1 g.s | cls (sw b (std x y i)) = (if b then 2 else 1)}
      = {i ∈ Icc 1 g.s | i ≤ x} :=
    filter_congr fun i _ => by rw [cls_sw_std]; cases b <;> split_ifs <;> simp_all
  have cB : {i ∈ Icc 1 g.s | cls (sw b (std x y i)) = (if b then 1 else 2)}
      = {i ∈ Icc 1 g.s | ¬ i ≤ y} :=
    filter_congr fun i _ => by rw [cls_sw_std]; cases b <;> split_ifs <;> simp_all <;> omega
  refine ⟨by rw [hf, c0, card_Icc_mid g.s x y hy], ?_, ?_⟩
  · cases b
    · have := cA; simp only [Bool.false_eq_true, ite_false] at this
      rw [hf, this, card_Icc_le g.s x (by omega)]; rfl
    · have := cB; simp only [ite_true] at this
      rw [hf, this, card_Icc_gt g.s y]; rfl
  · cases b
    · have := cB; simp only [Bool.false_eq_true, ite_false] at this
      rw [hf, this, card_Icc_gt g.s y]; rfl
    · have := cA; simp only [ite_true] at this
      rw [hf, this, card_Icc_le g.s x (by omega)]; rfl

lemma sum_e_of_pattern {x y : ℕ} {b : Bool} (hxy : x ≤ y)
    (hp : ∀ i ∈ Icc 1 g.s, g.e i = sw b (std x y i)) :
    ∀ j ≤ g.s, ∑ i ∈ Icc 1 j, g.e i = sw b (walk x (y - x) j) := by
  intro j
  induction j with
  | zero => intro _; simp [walk_zero, sw_zero]
  | succ j ih =>
    intro hj
    rw [Finset.sum_Icc_succ_top (by omega), ih (by omega), hp (j + 1) (by simp; omega),
      walk_succ, sw_add, show x + (y - x) = y by omega]

/-- **The rooted growth order is a washtub walk.** -/
theorem rooted_walk (hroot : ∀ i ≤ g.s, form 2 (g.pt 0) ≤ form 2 (g.pt i))
    (hW : Wsum S = 3 * g.s + g.mm) (hw2 : wd 2 S = g.s + g.mm) (hs : 1 ≤ g.s)
    (hbal : Balanced (g.count 0) (g.count 1) (g.count 2)) :
    ∃ x y : ℕ, ∃ b : Bool, x ≤ y ∧ y ≤ g.s ∧ Trip g.s x y ∧
      ∀ j ≤ g.s, g.pt j = g.pt 0 + sw b (walk x (y - x) j) := by
  obtain ⟨M, N, h, hN⟩ := g.exists_ext 2 0 (Nat.zero_le _) hroot
  obtain ⟨hc0, hD, hch, -⟩ := g.rooted_path h hN hw2
  have hsum := g.count_sum
  have hmm : g.mm = max (g.count 0) (max (g.count 1) (g.count 2)) := rfl
  have hm1 : 1 ≤ g.mm := by unfold Balanced at hbal; omega
  -- a step pattern together with the run lengths
  obtain ⟨x, y, b, hxy, hy, htrip, hp⟩ : ∃ x y : ℕ, ∃ b : Bool, x ≤ y ∧ y ≤ g.s ∧ Trip g.s x y ∧
      ∀ i ∈ Icc 1 g.s, g.e i = sw b (std x y i) := by
    by_cases h3 : 3 ≤ g.s
    · obtain ⟨x, y, b, hxy, hy, hp⟩ := g.rooted_pattern hroot hW hw2 hm1
        (by unfold Balanced at hbal; omega) (by unfold Balanced at hbal; omega)
      obtain ⟨h0, h1, h2⟩ := g.count_of_pattern hxy.le hy hp
      refine ⟨x, y, b, hxy.le, hy, ?_, hp⟩
      unfold Balanced at hbal
      unfold Trip
      cases b <;> simp only [ite_true, ite_false, Bool.false_eq_true] at h1 h2 <;> omega
    · have hc01 : g.count 0 = 1 := by unfold Balanced at hbal; omega
      obtain ⟨i₁, hi₁, hcl₁⟩ := g.exists_of_count (k := 0) (by omega)
      rcases (show g.s = 1 ∨ g.s = 2 by omega) with hs1 | hs2
      · -- one step, which is `d₁`
        have hi1 : i₁ = 1 := by simp only [mem_Icc] at hi₁; omega
        subst hi1
        have he : g.e 1 = (1, 0) := by
          rcases hD 1 hi₁ with he | he | he <;> rw [he] at hcl₁ ⊢ <;> revert hcl₁ <;> decide
        refine ⟨0, 1, false, by omega, by omega, by unfold Trip; omega, fun i hi => ?_⟩
        have : i = 1 := by simp only [mem_Icc] at hi; omega
        subst this
        rw [he]; decide
      · -- two steps, exactly one of which is `d₁`
        have h12 : Icc 1 g.s = {1, 2} := by rw [hs2]; decide
        have hcnt : g.count 0 = (if cls (g.e 1) = 0 then 1 else 0)
            + (if cls (g.e 2) = 0 then 1 else 0) := by
          unfold count
          rw [h12, filter_insert, filter_singleton]
          split_ifs <;> simp
        rw [hc01] at hcnt
        have hm1 : (1 : ℕ) ∈ Icc 1 g.s := by rw [h12]; simp
        have hm2 : (2 : ℕ) ∈ Icc 1 g.s := by rw [h12]; simp
        have key : ∃ x y : ℕ, ∃ b : Bool, x ≤ y ∧ y ≤ 2 ∧ Trip 2 x y ∧
            g.e 1 = sw b (std x y 1) ∧ g.e 2 = sw b (std x y 2) := by
          rcases hD 1 hm1 with e1 | e1 | e1 <;> rcases hD 2 hm2 with e2 | e2 | e2 <;>
            rw [e1, e2] at hcnt ⊢ <;>
            first
              | exact absurd hcnt (by decide)
              | exact ⟨0, 1, false, by decide, by decide, by unfold Trip; decide, by decide, by decide⟩
              | exact ⟨0, 1, true, by decide, by decide, by unfold Trip; decide, by decide, by decide⟩
              | exact ⟨1, 2, false, by decide, by decide, by unfold Trip; decide, by decide, by decide⟩
              | exact ⟨1, 2, true, by decide, by decide, by unfold Trip; decide, by decide, by decide⟩
        obtain ⟨x, y, b, hxy, hy, ht, he1, he2⟩ := key
        refine ⟨x, y, b, hxy, by omega, by rw [hs2]; exact ht, fun i hi => ?_⟩
        rw [h12] at hi
        simp only [mem_insert, mem_singleton] at hi
        rcases hi with rfl | rfl
        · exact he1
        · exact he2
  refine ⟨x, y, b, hxy, hy, htrip, fun j hj => ?_⟩
  rw [g.pt_eq_sum hj, hch j hj, g.sum_e_of_pattern hxy hp j hj]

end Growth

/-! ### The final assembly -/

lemma rhoP_pow_three (c : Cell) : (rhoP ^ 3) c = -c := by
  simp only [rhoP_pow_succ_apply, pow_zero, Equiv.Perm.one_apply, rhoP_apply]
  ext <;> simp

lemma rhoP_pow_inv_add (j : ℕ) (a b : Cell) :
    (rhoP ^ j)⁻¹ (a + b) = (rhoP ^ j)⁻¹ a + (rhoP ^ j)⁻¹ b := by
  apply (rhoP ^ j).injective
  rw [rhoP_pow_add]
  simp

/-- Apply `σ` or not, as a permutation. -/
def swP (b : Bool) : Equiv.Perm Cell := if b then sigP else 1

lemma swP_apply (b : Bool) (c : Cell) : swP b c = sw b c := by
  cases b <;> rfl

/-- The group of lattice symmetries generated by `ρ` and `σ`. -/
abbrev latticeSym : Subgroup (Equiv.Perm Cell) := Subgroup.closure {rhoP, sigP}

lemma rhoP_mem : rhoP ∈ latticeSym := Subgroup.subset_closure (Set.mem_insert _ _)

lemma sigP_mem : sigP ∈ latticeSym := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

lemma swP_mem (b : Bool) : swP b ∈ latticeSym := by
  cases b
  · exact Subgroup.one_mem _
  · exact sigP_mem

/-- **Uniqueness of the extremal polyhex.** A polyhex whose convex hull has the largest possible
area `⌈n² + 14n/3⌉ / 6` is, up to a lattice symmetry generated by `ρ(q, r) = (-r, q + r)` and
`σ(q, r) = (q + r, -r)` and a translation, the washtub `washtub n`. -/
theorem washtub_unique (S : Finset Cell) (hS : IsPolyhex S)
    (hmax : volume (convexHull ℝ (region S))
      = ENNReal.ofReal ((⌈(S.card : ℝ) ^ 2 + 14 / 3 * S.card⌉ : ℝ) / 6)) :
    ∃ φ ∈ latticeSym, ∃ t : Cell, S = (washtub S.card).image (fun c => φ c + t) := by
  classical
  obtain ⟨g₀⟩ := exists_growth hS
  have hcard₀ := g₀.card_eq
  -- one cell
  by_cases hs0 : g₀.s = 0
  · obtain ⟨c, hc⟩ := Finset.card_eq_one.mp (by omega : S.card = 1)
    refine ⟨1, Subgroup.one_mem _, c, ?_⟩
    rw [hc, card_singleton]
    show {c} = (tub 0 0 0).image _
    simp [tub, walk_zero]
  have hs1 : 1 ≤ g₀.s := by omega
  -- step 1 and step 2 on an arbitrary growth order
  obtain ⟨hW₀, hbal₀⟩ := extremal_growth hmax g₀
  have hm₀ : 1 ≤ g₀.mm := by
    have := g₀.count_sum; unfold Balanced at hbal₀; unfold Growth.mm; omega
  obtain ⟨M₀, N₀, hext₀⟩ := g₀.exists_ext'
  obtain ⟨k, hk⟩ := g₀.exists_wide hext₀ hW₀ hm₀
  -- step 3: rotate so that the wide form is `form 2`
  set j : ℕ := ((2 : Fin 3) - k).val with hj
  have hjk : (2 : Fin 3) - (j : Fin 3) = k := by
    rw [hj, Fin.cast_val_eq_self, sub_sub_cancel]
  set ψ := rhoP ^ j with hψ
  set S' := S.image ψ with hS'
  have hne' : S'.Nonempty := (hS.1).image _
  obtain ⟨r', hr'S, hr'⟩ := exists_min_image S' (form 2) hne'
  obtain ⟨c₀, hc₀, hc₀r⟩ := mem_image.mp hr'S
  obtain ⟨g₁, hg₁⟩ := exists_growth_root hS hc₀
  obtain ⟨hW₁, hbal₁⟩ := extremal_growth hmax g₁
  have hcard₁ := g₁.card_eq
  set g' := g₁.mapRho j with hg'
  have hs' : g'.s = g₁.s := rfl
  have hpt' : ∀ i, g'.pt i = ψ (g₁.pt i) := fun _ => rfl
  -- the counts of `g'` are a cyclic shift of those of `g₁`
  have hshift : (g'.count 0 = g₁.count 0 ∧ g'.count 1 = g₁.count 1 ∧ g'.count 2 = g₁.count 2) ∨
      (g'.count 0 = g₁.count 2 ∧ g'.count 1 = g₁.count 0 ∧ g'.count 2 = g₁.count 1) ∨
      (g'.count 0 = g₁.count 1 ∧ g'.count 1 = g₁.count 2 ∧ g'.count 2 = g₁.count 0) := by
    simp only [hg', Growth.mapRho_count]
    generalize (j : Fin 3) = j'
    fin_cases j'
    · exact Or.inl ⟨rfl, rfl, rfl⟩
    · exact Or.inr (Or.inl ⟨rfl, rfl, rfl⟩)
    · exact Or.inr (Or.inr ⟨rfl, rfl, rfl⟩)
  have hsum₁ := g₁.count_sum
  have hsum' := g'.count_sum
  have hbal' : Balanced (g'.count 0) (g'.count 1) (g'.count 2) := by
    unfold Balanced at hbal₁ ⊢; omega
  have hmm' : g'.mm = g₁.mm := by
    unfold Growth.mm; omega
  have hmm₀₁ : g₀.mm = g₁.mm := by
    have := g₀.count_sum
    unfold Growth.mm
    rw [mm_of_balanced hbal₀, mm_of_balanced hbal₁]
    omega
  have hW' : Wsum S' = 3 * g'.s + g'.mm := by
    rw [hS', hψ, Wsum_rhoP_pow, hW₁, hs', hmm']
  have hw2' : wd 2 S' = g'.s + g'.mm := by
    rw [hS', hψ, wd_rhoP_pow, hjk, hk, hmm₀₁, ← hmm', hs']
    congr 1
    omega
  have hroot' : ∀ i ≤ g'.s, form 2 (g'.pt 0) ≤ form 2 (g'.pt i) := by
    intro i hi
    have h0 : g'.pt 0 = r' := by rw [hpt', hg₁, hc₀r]
    rw [h0]
    exact hr' _ (g'.pt_mem hi)
  obtain ⟨x, y, b, hxy, hy, htrip, hwalk⟩ :=
    g'.rooted_walk hroot' hW' hw2' (by omega) hbal'
  -- the cells of `S'` and of `S`
  have hr'0 : g'.pt 0 = r' := by rw [hpt', hg₁, hc₀r]
  have hS'eq : S' = (tub x (y - x) (g'.s - y)).image (fun c => sw b c + r') := by
    refine g'.image_eq.symm.trans ?_
    rw [tub, image_image, show x + (y - x) + (g'.s - y) + 1 = g'.s + 1 by omega]
    refine image_congr fun i hi => ?_
    simp only [coe_range, Set.mem_Iio] at hi
    simp only [Function.comp, hwalk i (by omega), hr'0]
    abel
  have hn : S.card = g'.s + 1 := by omega
  generalize hsg : g'.s = s at hS'eq htrip hy hxy hn
  have hSeq : S = S'.image (fun c => ψ⁻¹ c) := by
    rw [hS', image_image]
    conv_lhs => rw [← image_id (s := S)]
    congr 1
    funext c
    simp
  -- step 4: identify the run lengths
  unfold Trip at htrip
  rcases htrip with ⟨hm, ⟨hx, hz⟩ | ⟨hx, hz⟩⟩
  · refine ⟨ψ⁻¹ * swP b, Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.pow_mem _ rhoP_mem _))
      (swP_mem b), ψ⁻¹ r', ?_⟩
    have htub : washtub S.card = tub x (y - x) (s - y) := by
      rw [hn, washtub]
      congr 1 <;> omega
    rw [htub]
    refine hSeq.trans ?_
    rw [hS'eq, image_image]
    refine image_congr fun c _ => ?_
    simp only [Function.comp, Equiv.Perm.mul_apply, swP_apply, hψ, rhoP_pow_inv_add]
  · refine ⟨ψ⁻¹ * swP b * (sigP * rhoP ^ 3),
      Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.pow_mem _ rhoP_mem _))
        (swP_mem b)) (Subgroup.mul_mem _ sigP_mem (Subgroup.pow_mem _ rhoP_mem _)),
      ψ⁻¹ (sw b ((((y - x + (s - y) : ℕ) : ℤ), ((x : ℤ) - (s - y : ℕ)))) + r'), ?_⟩
    have htub : washtub S.card = tub (s - y) (y - x) x := by
      rw [hn, washtub]
      congr 1 <;> omega
    rw [htub]
    refine hSeq.trans ?_
    rw [hS'eq, tub_rev (s - y) (y - x) x, image_image, image_image]
    refine image_congr fun c _ => ?_
    simp only [Function.comp, Equiv.Perm.mul_apply, swP_apply, sigP_apply, rhoP_pow_three, hψ,
      rhoP_pow_inv_add, sw_add]
    abel

end Polyhex
